{
    "version": 2,
    "builds": [
        {
            "src": "main.py",
            "use": "@vercel/python",
            "config": {
                "includeFiles": [
                    "static/**"
                ]
            }
        }
    ],
    "headers": [
        {
            "source": "/static/images/(.*)",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
            ]
        },
        {
            "source": "/static/css/(.*)",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
            ]
        },
        {
            "source": "/static/js/(.*)",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
            ]
        },
        {
            "source": "/sitemap.xml",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400" }
            ]
        },
        {
            "source": "/rss.xml",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400" }
            ]
        }
    ],
    "routes": [
        {
            "handle": "filesystem"
        },
        {
            "src": "/(.*)",
            "dest": "main.py"
        }
    ]
}